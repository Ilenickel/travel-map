{
  "rewrites": [
    { "source": "/pays/:slug", "destination": "/pays/:slug/index.html" },
    { "source": "/planifier", "destination": "/planifier/index.html" },
    { "source": "/((?!api|pays|assets|_vercel|[^/]+\\.[^/]+$).*)", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "travel-map-blush.vercel.app" }],
      "destination": "https://triply-travel.vercel.app/:path*",
      "permanent": true
    }
  ]
}
